												"policy": {
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"variableName": "maxFileLastModified",
													"value": {
														"value": "@activity('GetMetadataOfFile').output.lastModified",
														"type": "Expression"
													}
												}
											}
										]
