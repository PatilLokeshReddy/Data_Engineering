{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "voltgridadf"
		},
		"VoltGrid_StorageAccount_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'VoltGrid_StorageAccount'"
		},
		"LS_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://voltGridKeyVault.vault.azure.net/"
		},
		"LS_KeyVault_StorageAccount_Access_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://voltgridstorageaccount.dfs.core.windows.net/"
		},
		"VoltGrid_StorageAccount_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://voltgridstorageaccount.dfs.core.windows.net/"
		},
		"rest_voltgrid_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ev-project-navy-mu.vercel.app"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "voltgridadf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"VoltGrid_StorageAccount_accountKey": {
						"value": "[parameters('VoltGrid_StorageAccount_accountKey')]"
					},
					"LS_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_properties_typeProperties_baseUrl')]"
					},
					"VoltGrid_StorageAccount_properties_typeProperties_url": {
						"value": "[parameters('VoltGrid_StorageAccount_properties_typeProperties_url')]"
					},
					"rest_voltgrid_api_properties_typeProperties_url": {
						"value": "[parameters('rest_voltgrid_api_properties_typeProperties_url')]"
					},
					"LS_KeyVault_StorageAccount_Access_properties_typeProperties_url": {
						"value": "[parameters('LS_KeyVault_StorageAccount_Access_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}